* text=auto eol=lf

# سكريبتات ويندوز (local/) — cmd/PowerShell محتاجين CRLF، فبتتسحب كده حتى على لينكس/ماك.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

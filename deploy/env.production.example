# قالب .env للإنتاج — نسخة مرجعية بس، مش ملف حقيقي بيتقرا. **صفر باسورد أو سر حقيقي هنا
# ولا في أي مكان تاني في الريبو** — كل قيمة فيها `__` placeholder لازم تتكتب بإيد الشخص اللي
# بيعمل الديبلوي مباشرة على السيرفر، مش تتحط هنا ولا تتبعت في أي رسالة أو ملف تاني.
#
# طريقة الاستخدام: `cp deploy/env.production.example .env` على السيرفر، وبعدين تعدّل كل
# سطر فيه __PLACEHOLDER__ بالقيمة الحقيقية. راجع `deploy/DEPLOYMENT.md` للخطوات الكاملة.

APP_NAME="برق"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://barq.tafraos.com
APP_TIMEZONE=Africa/Cairo

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# قاعدة بيانات MySQL مستقلة تماماً — اسم/يوزر مختلفين عن قاعدة بيانات Tafra ERP (`erp`)
# الموجودة على نفس السيرفر. صفر مشاركة داتابيز بين المشروعين (قاعدة ثابتة في CLAUDE.md).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barq
DB_USERNAME=barq
DB_PASSWORD=__DB_PASSWORD__

# جدول sessions أصلاً موجود من أول migration (users/password_reset_tokens/sessions مع بعض) —
# صفر migration إضافي مطلوب لتفعيل session driver=database.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# صفر Job class موجود فعلياً في المشروع لحد دلوقتي — driver=database كافي ومفيش داعي لـ
# queue worker منفصل. لو المشروع لاحقاً ضاف queued jobs (زي إعادة محاولة push المحتوى
# لـ WordPress)، وقتها لازم systemd service جديد بـ `php artisan queue:work` — تفصيلها
# في DEPLOYMENT.md لو احتجتها.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@tafraos.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ===== إعدادات برق الخاصة =====
BARQ_ADMIN_HOST=barq.tafraos.com
BARQ_BASE_DOMAIN=barq.tafraos.com

# نموذج الذكاء الاصطناعي المحلي (Ollama) — لازم يكون متسطّب ومشغّل على نفس السيرفر
# (`ollama pull qwen3:8b`) قبل ما ميزة اقتراح المحتوى تشتغل في الإنتاج. ده استهلاك رام/قرص
# حقيقي على سيرفر أصلاً شغّال عليه Tafra ERP — قرار يستاهل تفكير قبل التفعيل، مش افتراض
# إنه هيمشي لوحده. لو مش عايز تفعّلها دلوقتي، سيبها زي ما هي — الميزة هترجع تفشل بأمان
# (OllamaService بيتعامل مع فشل الاتصال من غير ما يكسر باقي النظام).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120

# شبكة WordPress Multisite (Phase 5) — لسه محتاجة تتبني كبنية تحتية منفصلة (مفيش أي سيرفر
# WordPress فعلي جاهز دلوقتي). سيبهم فاضيين لحد ما الشبكة دي تتعمل فعلاً — قوالب
# `kind=wordpress` هتفضل تعرض شاشة "لسه بيتجهّز" للزوار طول ما القيم دي فاضية، وده سلوك
# آمن ومقصود (صفر كسر لو حد عمل مشروع بقالب WordPress قبل ما الشبكة تتجهّز).
WORDPRESS_NETWORK_URL=
WORDPRESS_SHARED_SECRET=
